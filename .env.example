# Postgres credentials (used by docker-compose)
POSTGRES_USER=tags
POSTGRES_PASSWORD=changeme
POSTGRES_DB=tags

# Connection string for local (non-Docker) dev, e.g. drizzle-kit / npm run dev
DATABASE_URL=postgres://tags:changeme@localhost:5432/tags

# Comma-separated admin email allowlist, seeded into the `admins` table on
# boot. These emails get write access (must also be allowed in Cloudflare
# Access). Leave blank to seed no admins.
ADMIN_EMAILS=admin@example.com

# League name shown in the app header and page title. Each deployment sets its
# own — the same code runs for any league.
LEAGUE_NAME=Tags League

# Require a join code to check in and enter scores on a live round.
#
# Blank/false (the default): anyone who opens the site while a round is live
# can join it and edit that round's scores — including other players'. That is
# tolerable because a round is open for one afternoon, an admin can close it at
# any time, and the URL isn't advertised. It authorizes nothing else: the
# roster, tag status and finalizing all stay behind Cloudflare Access.
#
# Set to true to put the code gate back. Admins then read a four-letter code
# out at the tee (or share the join link), and wrong codes are rate limited per
# IP. Nothing else has to change — rounds mint, rotate, revoke and expire codes
# either way — so this is a one-line flip plus a restart, in both directions.
REQUIRE_ROUND_CODE=

# Optional theme overrides. Leave any blank to keep the app's default look.
# Colors are CSS hex; the pressed-button shade is derived from THEME_PRIMARY.
# THEME_FONT is any CSS font-family value (use a system/generic family, or load
# a web font yourself). Examples:
#   THEME_PRIMARY=#1f3a5f
#   THEME_ACCENT=#ffb703
#   THEME_SECONDARY=#457b9d
#   THEME_BG=#f2f4f7
#   THEME_FONT=Georgia, serif
#
# DARK THEMES: there is no separate switch. Give THEME_BG a dark color and the
# app inverts the whole surface set — cards, borders, body text, input fills —
# deriving each from THEME_BG so they keep its hue. Set a dark background with a
# light one in mind and you get white cards on black, so pick THEME_BG first.
# A dark example:
#   THEME_PRIMARY=#3a3a3c
#   THEME_ACCENT=#ffb340
#   THEME_SECONDARY=#b0a08a
#   THEME_BG=#131314
# Use theme-preview.html to cycle presets and copy a working set.
THEME_PRIMARY=
THEME_ACCENT=
THEME_SECONDARY=
THEME_BG=
THEME_FONT=
