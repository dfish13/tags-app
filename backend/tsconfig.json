{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "outDir": "./dist",
    "rootDir": "./src",
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "resolveJsonModule": true,
    "declaration": false,
    "sourceMap": true
  },
  "include": ["src/**/*"],
  // Tests and the local dev stack are excluded from the BUILD so they never
  // ship in the container image — src/dev/ forges an admin identity and wipes
  // the database, and neither belongs anywhere near production.
  // `npm run typecheck` uses tsconfig.test.json, which includes them.
  "exclude": ["node_modules", "dist", "src/**/*.test.ts", "src/test", "src/dev"]
}
